---
---

<div class="boat-widget">
  <div class="toolbar">
    <span class="label">Engine speed <em>v</em></span>
    <input
      type="range"
      class="v-slider"
      min="16" max="60" value="30" step="1"
      aria-label="Boat engine speed v"
    />
    <span class="readout" aria-live="polite">
      <span class="v-label"><em>v</em></span>&thinsp;=&thinsp;<span class="v-out">3.0</span>
      &emsp;
      <span class="u-label"><em>u</em>&thinsp;=&thinsp;<em>l</em>&thinsp;/&thinsp;2<em>T</em>&thinsp;=&thinsp;<span class="u-out">1.5</span></span>
      &ensp;<span class="tag-constant">constant</span>
    </span>
  </div>
  <canvas
    class="boat-canvas"
    aria-label="Dual x-t diagram. Lab frame on left: raft rises steadily; boat peaks higher then returns to the same fixed meeting point regardless of v. Water frame on right: raft is stationary; boat V grows or shrinks with v but always returns to zero at the same time."
  ></canvas>
</div>

<style>
  .boat-widget {
    border: 1px solid var(--color-widget-border);
    border-radius: 2px;
    margin: 2.5rem 0;
    overflow: hidden;
    font-family: var(--font-ui);
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid var(--color-widget-border);
    background: var(--color-surface);
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .v-slider {
    flex: 1 1 100px;
    min-width: 80px;
    max-width: 220px;
    accent-color: var(--color-data-2);
    cursor: pointer;
  }

  .readout {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .v-label { color: var(--color-data-2); }
  .v-label em { font-style: normal; }
  .u-label { color: var(--color-data-1); }
  .u-label em { font-style: normal; }
  .u-out { color: var(--color-data-1); }

  .tag-constant {
    font-size: 0.6rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.1em 0.35em;
    color: var(--color-data-1);
    letter-spacing: 0.06em;
    vertical-align: middle;
  }

  .boat-canvas {
    width: 100%;
    aspect-ratio: 5 / 2;
    display: block;
    background: var(--color-widget-bg);
  }
</style>

<script>
  // Fixed river speed (the "answer" held constant to show v doesn't affect it)
  const U_FIXED = 1.5;
  const T_TURN  = 1.0;
  const L_RAFT  = U_FIXED * 2 * T_TURN; // 3.0

  // Fixed y-scales so trajectories move visually while the meeting point stays put
  const Y_MAX_LAB   =  9.0;
  const Y_MIN_LAB   = -0.5;
  const Y_MAX_WATER =  7.0;
  const Y_MIN_WATER = -0.5;

  function setupCanvas(canvas: HTMLCanvasElement): CanvasRenderingContext2D {
    const dpr = window.devicePixelRatio ?? 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width  = Math.round(rect.width  * dpr);
    canvas.height = Math.round(rect.height * dpr);
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    return ctx;
  }

  function cssSize(canvas: HTMLCanvasElement) {
    const r = canvas.getBoundingClientRect();
    return { w: r.width, h: r.height };
  }

  function getColors(el: HTMLElement) {
    const cs = getComputedStyle(el);
    const g = (p: string) => cs.getPropertyValue(p).trim();
    return {
      bg:     g('--color-widget-bg'),
      surface: g('--color-surface'),
      border:  g('--color-widget-border'),
      text:    g('--color-text'),
      muted:   g('--color-text-muted'),
      axis:    g('--color-axis'),
      d1:      g('--color-data-1'),
      d2:      g('--color-data-2'),
    };
  }

  type C = ReturnType<typeof getColors>;

  function drawPanel(
    ctx: CanvasRenderingContext2D,
    C: C,
    uiFont: string,
    panelX: number, panelY: number, panelW: number, panelH: number,
    v: number,
    waterFrame: boolean,
  ) {
    const PL = 10, PR = 22, PT = 22, PB = 32;
    const plotX = panelX + PL;
    const plotY = panelY + PT;
    const plotW = panelW - PL - PR;
    const plotH = panelH - PT - PB;

    const tMax = 2 * T_TURN;
    const yMax = waterFrame ? Y_MAX_WATER : Y_MAX_LAB;
    const yMin = waterFrame ? Y_MIN_WATER : Y_MIN_LAB;

    const tx = (t: number) => plotX + t / tMax * plotW;
    const ty = (y: number) => plotY + (1 - (y - yMin) / (yMax - yMin)) * plotH;
    const botY = plotY + plotH;

    // Panel background
    ctx.fillStyle = C.bg;
    ctx.fillRect(panelX, panelY, panelW, panelH);

    // Panel title
    ctx.save();
    ctx.font = `9px ${uiFont}`;
    ctx.letterSpacing = '0.09em';
    ctx.fillStyle = C.muted;
    ctx.textAlign = 'center';
    ctx.fillText(
      waterFrame ? 'WATER FRAME  (on raft)' : 'LAB FRAME  (river bank)',
      panelX + panelW / 2,
      panelY + 14,
    );
    ctx.restore();

    // Helper: draw a segment in data coords
    function seg(t1: number, y1: number, t2: number, y2: number,
                 color: string, lw: number, dash: number[] = []) {
      ctx.save();
      ctx.strokeStyle = color;
      ctx.lineWidth = lw;
      ctx.setLineDash(dash);
      ctx.beginPath();
      ctx.moveTo(tx(t1), ty(y1));
      ctx.lineTo(tx(t2), ty(y2));
      ctx.stroke();
      ctx.restore();
    }

    function dot(t: number, y: number, color: string, r = 3.5) {
      ctx.save();
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(tx(t), ty(y), r, 0, 2 * Math.PI);
      ctx.fill();
      ctx.restore();
    }

    // y = 0 reference line
    seg(0, 0, tMax, 0, C.axis, 1, []);

    // Dashed vertical at turn-around t = T
    seg(T_TURN, yMin, T_TURN, yMax * 0.9, C.axis, 1, [3, 4]);

    // Time axis ticks and labels
    ctx.save();
    ctx.strokeStyle = C.axis;
    ctx.lineWidth = 1;
    ctx.font = `8px ${uiFont}`;
    ctx.letterSpacing = '0.04em';
    ctx.fillStyle = C.muted;
    ctx.textAlign = 'center';
    for (const [t, lbl] of [[0, '0'], [T_TURN, 'T'], [tMax, '2T']] as [number, string][]) {
      ctx.beginPath();
      ctx.moveTo(tx(t), botY); ctx.lineTo(tx(t), botY + 4);
      ctx.stroke();
      ctx.fillText(lbl, tx(t), botY + 14);
    }
    ctx.fillText('time \u2192', plotX + plotW / 2, panelY + panelH - 4);
    ctx.restore();

    if (waterFrame) {
      // Raft: stationary at y = 0
      seg(0, 0, tMax, 0, C.d1, 2.5);

      // Boat: 0 → (T, v·T) → (2T, 0)
      const peak = v * T_TURN;
      seg(0, 0, T_TURN, peak, C.d2, 2);
      seg(T_TURN, peak, tMax, 0, C.d2, 2);

      // Labels
      ctx.save();
      ctx.font = `9px ${uiFont}`;
      ctx.letterSpacing = '0.07em';
      ctx.fillStyle = C.d1;
      ctx.textAlign = 'left';
      ctx.fillText('RAFT', tx(0.08 * tMax), ty(0) - 7);
      ctx.fillStyle = C.d2;
      ctx.textAlign = 'center';
      ctx.fillText('BOAT', tx(T_TURN * 0.42), ty(peak * 0.55) - 6);
      ctx.restore();

      dot(0, 0, C.muted, 3);
      dot(tMax, 0, C.d1, 4.5);

    } else {
      // Raft: 0 → (2T, L)
      seg(0, 0, tMax, L_RAFT, C.d1, 2.5);

      // Boat: 0 → (T, (v+U)·T) → (2T, L)
      const peak = (v + U_FIXED) * T_TURN;
      seg(0, 0, T_TURN, peak, C.d2, 2);
      seg(T_TURN, peak, tMax, L_RAFT, C.d2, 2);

      // Labels
      ctx.save();
      ctx.font = `9px ${uiFont}`;
      ctx.letterSpacing = '0.07em';
      ctx.fillStyle = C.d1;
      ctx.textAlign = 'left';
      ctx.fillText('RAFT', tx(T_TURN * 0.55), ty(L_RAFT * 0.65) + 12);
      ctx.fillStyle = C.d2;
      ctx.fillText('BOAT', tx(T_TURN * 0.15), ty(peak * 0.45) - 6);
      ctx.restore();

      // Brace: l annotation at right edge from y=0 to y=L
      const bx = plotX + plotW + 5;
      ctx.save();
      ctx.strokeStyle = C.muted;
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.55;
      ctx.beginPath();
      ctx.moveTo(bx, ty(0)); ctx.lineTo(bx, ty(L_RAFT));
      ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.font = `italic 10px ${uiFont}`;
      ctx.fillStyle = C.muted;
      ctx.textAlign = 'left';
      ctx.fillText('l', bx + 4, ty(L_RAFT / 2) + 3);
      ctx.restore();

      dot(0, 0, C.muted, 3);
      // Meeting point: always at (2T, L) — this is the "fixed" dot
      dot(tMax, L_RAFT, C.d1, 4.5);
    }
  }

  function init(widget: HTMLElement) {
    const canvas = widget.querySelector<HTMLCanvasElement>('.boat-canvas')!;
    const slider = widget.querySelector<HTMLInputElement>('.v-slider')!;
    const vOut   = widget.querySelector<HTMLElement>('.v-out')!;
    const uOut   = widget.querySelector<HTMLElement>('.u-out')!;

    const getV = () => parseInt(slider.value, 10) / 10; // 16–60 → 1.6–6.0

    function render() {
      const v = getV();
      vOut.textContent = v.toFixed(1);
      uOut.textContent = (L_RAFT / (2 * T_TURN)).toFixed(1); // always 1.5

      const ctx = setupCanvas(canvas);
      const { w, h } = cssSize(canvas);
      const C = getColors(widget);
      const uiFont = getComputedStyle(widget).getPropertyValue('--font-ui').trim() || 'system-ui';

      ctx.fillStyle = C.bg;
      ctx.fillRect(0, 0, w, h);

      // Panel divider
      ctx.save();
      ctx.strokeStyle = C.border;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(w / 2, 0); ctx.lineTo(w / 2, h);
      ctx.stroke();
      ctx.restore();

      drawPanel(ctx, C, uiFont, 0,     0, w / 2, h, v, false);
      drawPanel(ctx, C, uiFont, w / 2, 0, w / 2, h, v, true);
    }

    slider.addEventListener('input', render);

    const ro = new ResizeObserver(() => render());
    ro.observe(widget);

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', render);

    render();
  }

  for (const el of document.querySelectorAll<HTMLElement>('.boat-widget')) {
    init(el);
  }
</script>
